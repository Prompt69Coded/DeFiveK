import { ShellPalette } from "theme.slint";
import { WindowFrame } from "window_frame.slint";
import { AppFiles, FileItemData } from "app_files.slint";
import { AppTerminal } from "app_terminal.slint";
import { AppEditor } from "app_editor.slint";
import { AppSettings } from "app_settings.slint";
import { AppAbout } from "app_about.slint";

export component WindowsMode inherits Rectangle {
    in-out property <string> clock-time: "12:00 PM";
    in-out property <string> clock-date: "10/23/2026";
    in-out property <bool> start-menu-open: false;
    in-out property <string> start-search-query: "";
    in-out property <bool> calendar-open: false;

    // Window Management State
    in-out property <bool> win-files-open: true;
    in-out property <bool> win-files-min: false;
    in-out property <bool> win-files-focused: true;

    in-out property <bool> win-term-open: false;
    in-out property <bool> win-term-min: false;
    in-out property <bool> win-term-focused: false;

    in-out property <bool> win-edit-open: false;
    in-out property <bool> win-edit-min: false;
    in-out property <bool> win-edit-focused: false;

    in-out property <bool> win-settings-open: false;
    in-out property <bool> win-settings-min: false;
    in-out property <bool> win-settings-focused: false;

    in-out property <bool> win-about-open: false;
    in-out property <bool> win-about-min: false;
    in-out property <bool> win-about-focused: false;

    // App Data bindings passed from parent
    in-out property <string> files-current-path: "/home/harry/Projects/defivek";
    in-out property <[FileItemData]> files-items;
    in-out property <int> files-selected-index: -1;
    in-out property <string> files-status-text: "Ready";
    in-out property <string> files-error-text: "";
    in-out property <bool> files-has-error: false;

    in-out property <string> term-output: "";
    in-out property <string> host-terminal-name: "Terminal";

    in-out property <string> edit-file-path: "";
    in-out property <string> edit-file-content: "";
    in-out property <string> edit-status: "Ready";
    in-out property <bool> edit-is-modified: false;

    // Callbacks to parent
    in-out property <string> selected-wallpaper: "aurora-borealis";
    callback wallpaper-selected(string);
    callback app-action(string);
    callback files-navigate(string);
    callback files-navigate-up();
    callback files-navigate-back();
    callback files-refresh();
    callback files-open-item(string, bool);

    callback term-run-command(string);
    callback term-launch-host();
    callback term-clear();

    callback edit-new();
    callback edit-open-preset(string);
    callback edit-save(string, string);

    callback settings-mode-selected(int);
    callback settings-toggle-theme();
    callback settings-toggle-shell-bar();
    callback settings-reset();

    // Helper functions for window focus & launch
    function focus_files() {
        root.win-files-focused = true;
        root.win-term-focused = false;
        root.win-edit-focused = false;
        root.win-settings-focused = false;
        root.win-about-focused = false;
    }
    function focus_term() {
        root.win-files-focused = false;
        root.win-term-focused = true;
        root.win-edit-focused = false;
        root.win-settings-focused = false;
        root.win-about-focused = false;
    }
    function focus_edit() {
        root.win-files-focused = false;
        root.win-term-focused = false;
        root.win-edit-focused = true;
        root.win-settings-focused = false;
        root.win-about-focused = false;
    }
    function focus_settings() {
        root.win-files-focused = false;
        root.win-term-focused = false;
        root.win-edit-focused = false;
        root.win-settings-focused = true;
        root.win-about-focused = false;
    }
    function focus_about() {
        root.win-files-focused = false;
        root.win-term-focused = false;
        root.win-edit-focused = false;
        root.win-settings-focused = false;
        root.win-about-focused = true;
    }

    function launch_or_toggle_files() {
        if (!root.win-files-open) {
            root.win-files-open = true;
            root.win-files-min = false;
            root.focus_files();
        } else if (root.win-files-min) {
            root.win-files-min = false;
            root.focus_files();
        } else if (root.win-files-focused) {
            root.win-files-min = true;
        } else {
            root.focus_files();
        }
    }

    function launch_or_toggle_term() {
        if (!root.win-term-open) {
            root.win-term-open = true;
            root.win-term-min = false;
            root.focus_term();
        } else if (root.win-term-min) {
            root.win-term-min = false;
            root.focus_term();
        } else if (root.win-term-focused) {
            root.win-term-min = true;
        } else {
            root.focus_term();
        }
    }

    function launch_or_toggle_edit() {
        if (!root.win-edit-open) {
            root.win-edit-open = true;
            root.win-edit-min = false;
            root.focus_edit();
        } else if (root.win-edit-min) {
            root.win-edit-min = false;
            root.focus_edit();
        } else if (root.win-edit-focused) {
            root.win-edit-min = true;
        } else {
            root.focus_edit();
        }
    }

    function launch_or_toggle_settings() {
        if (!root.win-settings-open) {
            root.win-settings-open = true;
            root.win-settings-min = false;
            root.focus_settings();
        } else if (root.win-settings-min) {
            root.win-settings-min = false;
            root.focus_settings();
        } else if (root.win-settings-focused) {
            root.win-settings-min = true;
        } else {
            root.focus_settings();
        }
    }

    function launch_or_toggle_about() {
        if (!root.win-about-open) {
            root.win-about-open = true;
            root.win-about-min = false;
            root.focus_about();
        } else if (root.win-about-min) {
            root.win-about-min = false;
            root.focus_about();
        } else if (root.win-about-focused) {
            root.win-about-min = true;
        } else {
            root.focus_about();
        }
    }

    function toggle_show_desktop() {
        if (root.win-files-min && root.win-term-min && root.win-edit-min && root.win-settings-min) {
            root.win-files-min = false;
            root.win-term-min = false;
            root.win-edit-min = false;
            root.win-settings-min = false;
        } else {
            root.win-files-min = true;
            root.win-term-min = true;
            root.win-edit-min = true;
            root.win-settings-min = true;
        }
    }

    // Windows 7 Transparent Desktop Workspace (Wallpapers rendered by shared engine)
    background: transparent;

    // ==========================================
    // 1. Desktop Shortcuts Area
    // ==========================================
    VerticalLayout {
        x: 18px;
        y: 18px;
        width: 84px;
        spacing: 14px;
        alignment: start;

        // Computer (opens root in Explorer)
        Rectangle {
            width: 80px;
            height: 74px;
            border-radius: 6px;
            background: comp-t.has-hover ? ShellPalette.surface-overlay : transparent;
            border-width: 1px;
            border-color: comp-t.has-hover ? ShellPalette.border-glass : transparent;

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Image {
                    width: 32px;
                    height: 32px;
                    horizontal-alignment: center;
                    source: @image-url("../../assets/icons/computer.svg");
                }
                Text { text: "Computer"; font-size: 11px; font-weight: 600; color: ShellPalette.dark-mode ? #ffffff : #0f172a; horizontal-alignment: center; }
            }
            comp-t := TouchArea {
                clicked => {
                    root.win-files-open = true;
                    root.win-files-min = false;
                    root.focus_files();
                    root.files-navigate("/");
                }
            }
        }

        // User Files
        Rectangle {
            width: 80px;
            height: 74px;
            border-radius: 6px;
            background: user-t.has-hover ? ShellPalette.surface-overlay : transparent;
            border-width: 1px;
            border-color: user-t.has-hover ? ShellPalette.border-glass : transparent;

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Image {
                    width: 32px;
                    height: 32px;
                    horizontal-alignment: center;
                    source: @image-url("../../assets/icons/folder.svg");
                }
                Text { text: "User Files"; font-size: 11px; font-weight: 600; color: ShellPalette.dark-mode ? #ffffff : #0f172a; horizontal-alignment: center; }
            }
            user-t := TouchArea {
                clicked => {
                    root.win-files-open = true;
                    root.win-files-min = false;
                    root.focus_files();
                    root.files-navigate("~");
                }
            }
        }

        // Terminal Shortcut
        Rectangle {
            width: 80px;
            height: 74px;
            border-radius: 6px;
            background: term-t.has-hover ? ShellPalette.surface-overlay : transparent;
            border-width: 1px;
            border-color: term-t.has-hover ? ShellPalette.border-glass : transparent;

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Image {
                    width: 32px;
                    height: 32px;
                    horizontal-alignment: center;
                    source: @image-url("../../assets/icons/terminal.svg");
                }
                Text { text: "Terminal"; font-size: 11px; font-weight: 600; color: ShellPalette.dark-mode ? #ffffff : #0f172a; horizontal-alignment: center; }
            }
            term-t := TouchArea {
                clicked => {
                    root.win-term-open = true;
                    root.win-term-min = false;
                    root.focus_term();
                }
            }
        }

        // Text Editor Shortcut
        Rectangle {
            width: 80px;
            height: 74px;
            border-radius: 6px;
            background: edit-t.has-hover ? ShellPalette.surface-overlay : transparent;
            border-width: 1px;
            border-color: edit-t.has-hover ? ShellPalette.border-glass : transparent;

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Image {
                    width: 32px;
                    height: 32px;
                    horizontal-alignment: center;
                    source: @image-url("../../assets/icons/editor.svg");
                }
                Text { text: "Text Editor"; font-size: 11px; font-weight: 600; color: ShellPalette.dark-mode ? #ffffff : #0f172a; horizontal-alignment: center; }
            }
            edit-t := TouchArea {
                clicked => {
                    root.win-edit-open = true;
                    root.win-edit-min = false;
                    root.focus_edit();
                }
            }
        }

        // Settings Shortcut
        Rectangle {
            width: 80px;
            height: 74px;
            border-radius: 6px;
            background: set-t.has-hover ? ShellPalette.surface-overlay : transparent;
            border-width: 1px;
            border-color: set-t.has-hover ? ShellPalette.border-glass : transparent;

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Image {
                    width: 32px;
                    height: 32px;
                    horizontal-alignment: center;
                    source: @image-url("../../assets/icons/settings.svg");
                }
                Text { text: "Settings"; font-size: 11px; font-weight: 600; color: ShellPalette.dark-mode ? #ffffff : #0f172a; horizontal-alignment: center; }
            }
            set-t := TouchArea {
                clicked => {
                    root.win-settings-open = true;
                    root.win-settings-min = false;
                    root.focus_settings();
                }
            }
        }

        // Recycle Bin
        Rectangle {
            width: 80px;
            height: 74px;
            border-radius: 6px;
            background: bin-t.has-hover ? ShellPalette.surface-overlay : transparent;
            border-width: 1px;
            border-color: bin-t.has-hover ? ShellPalette.border-glass : transparent;

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Image {
                    width: 32px;
                    height: 32px;
                    horizontal-alignment: center;
                    source: @image-url("../../assets/icons/trash.svg");
                }
                Text { text: "Recycle Bin"; font-size: 11px; font-weight: 600; color: ShellPalette.dark-mode ? #ffffff : #0f172a; horizontal-alignment: center; }
            }
            bin-t := TouchArea {
                clicked => {
                    root.win-files-open = true;
                    root.win-files-min = false;
                    root.focus_files();
                    root.app-action("Recycle Bin is currently empty");
                }
            }
        }
    }

    // ==========================================
    // 2. Active Desktop Application Windows
    // ==========================================
    // Workspace Container: dimensions bounded between top and bottom taskbar
    workspace := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - 46px;

        // Dismiss start menu or popups when clicking desktop background
        TouchArea {
            clicked => {
                root.start-menu-open = false;
                root.calendar-open = false;
            }
        }

        // --- Window 1: File Explorer ---
        WindowFrame {
            title: "File Explorer — " + root.files-current-path;
            icon: "📁";
            win-x: 110px;
            win-y: 20px;
            win-width: min(680px, workspace.width - 120px);
            win-height: min(420px, workspace.height - 40px);
            max-bounds-width: workspace.width;
            max-bounds-height: workspace.height;
            is-open: root.win-files-open;
            is-minimized: root.win-files-min;
            is-focused: root.win-files-focused;
            mode-style: 0;

            focused => { root.focus_files(); }
            close-clicked => { root.win-files-open = false; }
            minimize-clicked => { root.win-files-min = true; }

            AppFiles {
                current-path: root.files-current-path;
                items: root.files-items;
                selected-index: root.files-selected-index;
                status-text: root.files-status-text;
                error-text: root.files-error-text;
                has-error: root.files-has-error;

                navigate-to(p) => { root.files-navigate(p); }
                navigate-up => { root.files-navigate-up(); }
                navigate-back => { root.files-navigate-back(); }
                refresh-folder => { root.files-refresh(); }
                open-item(p, is_dir) => { root.files-open-item(p, is_dir); }
            }
        }

        // --- Window 2: Terminal ---
        WindowFrame {
            title: "DeFiveK Terminal — zsh / host shell";
            icon: "💻";
            win-x: 160px;
            win-y: 50px;
            win-width: min(620px, workspace.width - 170px);
            win-height: min(380px, workspace.height - 70px);
            max-bounds-width: workspace.width;
            max-bounds-height: workspace.height;
            is-open: root.win-term-open;
            is-minimized: root.win-term-min;
            is-focused: root.win-term-focused;
            mode-style: 0;

            focused => { root.focus_term(); }
            close-clicked => { root.win-term-open = false; }
            minimize-clicked => { root.win-term-min = true; }

            AppTerminal {
                terminal-output: root.term-output;
                host-terminal-name: root.host-terminal-name;
                run-command(cmd) => { root.term-run-command(cmd); }
                launch-host-terminal => { root.term-launch-host(); }
                clear-output => { root.term-clear(); }
            }
        }

        // --- Window 3: Text Editor ---
        WindowFrame {
            title: "Text Editor — " + root.edit-file-path;
            icon: "📝";
            win-x: 210px;
            win-y: 70px;
            win-width: min(600px, workspace.width - 220px);
            win-height: min(400px, workspace.height - 90px);
            max-bounds-width: workspace.width;
            max-bounds-height: workspace.height;
            is-open: root.win-edit-open;
            is-minimized: root.win-edit-min;
            is-focused: root.win-edit-focused;
            mode-style: 0;

            focused => { root.focus_edit(); }
            close-clicked => { root.win-edit-open = false; }
            minimize-clicked => { root.win-edit-min = true; }

            AppEditor {
                file-path: root.edit-file-path;
                file-content: root.edit-file-content;
                status-message: root.edit-status;
                is-modified: root.edit-is-modified;

                new-file => { root.edit-new(); }
                open-preset(p) => { root.edit-open-preset(p); }
                save-file(p, c) => { root.edit-save(p, c); }
            }
        }

        // --- Window 4: Settings ---
        WindowFrame {
            title: "System Settings & Appearance";
            icon: "⚙️";
            win-x: 250px;
            win-y: 60px;
            win-width: min(600px, workspace.width - 260px);
            win-height: min(440px, workspace.height - 80px);
            max-bounds-width: workspace.width;
            max-bounds-height: workspace.height;
            is-open: root.win-settings-open;
            is-minimized: root.win-settings-min;
            is-focused: root.win-settings-focused;
            mode-style: 0;

            focused => { root.focus_settings(); }
            close-clicked => { root.win-settings-open = false; }
            minimize-clicked => { root.win-settings-min = true; }

            AppSettings {
                current-mode: 0;
                dark-mode: ShellPalette.dark-mode;
                selected-wallpaper: root.selected-wallpaper;
                wallpaper-selected(w) => { root.wallpaper-selected(w); }
                mode-selected(m) => { root.settings-mode-selected(m); }
                toggle-theme => { root.settings-toggle-theme(); }
                toggle-shell-bar => { root.settings-toggle-shell-bar(); }
                reset-defaults => { root.settings-reset(); }
            }
        }

        // --- Window 5: About DeFiveK Desktop ---
        WindowFrame {
            title: "About DeFiveK Desktop";
            icon: "✦";
            win-x: 280px;
            win-y: 80px;
            win-width: min(520px, workspace.width - 290px);
            win-height: min(380px, workspace.height - 100px);
            max-bounds-width: workspace.width;
            max-bounds-height: workspace.height;
            is-open: root.win-about-open;
            is-minimized: root.win-about-min;
            is-focused: root.win-about-focused;
            mode-style: 0;

            focused => { root.focus_about(); }
            close-clicked => { root.win-about-open = false; }
            minimize-clicked => { root.win-about-min = true; }

            AppAbout {
                current-mode: 0;
            }
        }
    }

    // ==========================================
    // 3. Start Menu (Modernized Windows 7)
    // ==========================================
    if root.start-menu-open : Rectangle {
        x: 8px;
        y: parent.height - 486px;
        width: 390px;
        height: 436px;
        border-radius: 8px;
        background: ShellPalette.surface;
        border-width: 1px;
        border-color: ShellPalette.border;
        clip: true;

        VerticalLayout {
            // Panels
            HorizontalLayout {
                vertical-stretch: 1;

                // Left Panel: Searchable Applications
                Rectangle {
                    width: 230px;
                    background: ShellPalette.surface;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        alignment: start;

                        // Pinned: File Explorer
                        Rectangle {
                            height: 36px; border-radius: 4px;
                            background: sm-f.has-hover ? ShellPalette.surface-hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 10px;
                                Rectangle {
                                    width: 22px; height: 22px;
                                    Text { text: "📁"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout { alignment: center; spacing: 1px;
                                    Text { text: "File Explorer"; font-size: 12px; font-weight: 600; color: ShellPalette.text-primary; }
                                    Text { text: "Browse files and places"; font-size: 9px; color: ShellPalette.text-muted; }
                                }
                            }
                            sm-f := TouchArea { clicked => { root.start-menu-open = false; root.launch_or_toggle_files(); } }
                        }

                        // Pinned: Terminal
                        Rectangle {
                            height: 36px; border-radius: 4px;
                            background: sm-t.has-hover ? ShellPalette.surface-hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 10px;
                                Rectangle {
                                    width: 22px; height: 22px;
                                    Text { text: "💻"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout { alignment: center; spacing: 1px;
                                    Text { text: "DeFiveK Terminal"; font-size: 12px; font-weight: 600; color: ShellPalette.text-primary; }
                                    Text { text: "Command line & tools"; font-size: 9px; color: ShellPalette.text-muted; }
                                }
                            }
                            sm-t := TouchArea { clicked => { root.start-menu-open = false; root.launch_or_toggle_term(); } }
                        }

                        // Pinned: Text Editor
                        Rectangle {
                            height: 36px; border-radius: 4px;
                            background: sm-e.has-hover ? ShellPalette.surface-hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 10px;
                                Rectangle {
                                    width: 22px; height: 22px;
                                    Text { text: "📝"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout { alignment: center; spacing: 1px;
                                    Text { text: "Text Editor"; font-size: 12px; font-weight: 600; color: ShellPalette.text-primary; }
                                    Text { text: "Edit documents and code"; font-size: 9px; color: ShellPalette.text-muted; }
                                }
                            }
                            sm-e := TouchArea { clicked => { root.start-menu-open = false; root.launch_or_toggle_edit(); } }
                        }

                        // Pinned: Settings
                        Rectangle {
                            height: 36px; border-radius: 4px;
                            background: sm-s.has-hover ? ShellPalette.surface-hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 10px;
                                Rectangle {
                                    width: 22px; height: 22px;
                                    Text { text: "⚙️"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout { alignment: center; spacing: 1px;
                                    Text { text: "System Settings"; font-size: 12px; font-weight: 600; color: ShellPalette.text-primary; }
                                    Text { text: "Themes, modes, configuration"; font-size: 9px; color: ShellPalette.text-muted; }
                                }
                            }
                            sm-s := TouchArea { clicked => { root.start-menu-open = false; root.launch_or_toggle_settings(); } }
                        }

                        // Pinned: About DeFiveK
                        Rectangle {
                            height: 36px; border-radius: 4px;
                            background: sm-a.has-hover ? ShellPalette.surface-hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 10px;
                                Rectangle {
                                    width: 22px; height: 22px;
                                    Text { text: "✦"; font-size: 16px; color: ShellPalette.accent; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout { alignment: center; spacing: 1px;
                                    Text { text: "About DeFiveK"; font-size: 12px; font-weight: 600; color: ShellPalette.text-primary; }
                                    Text { text: "Version, status, specifications"; font-size: 9px; color: ShellPalette.text-muted; }
                                }
                            }
                            sm-a := TouchArea { clicked => { root.start-menu-open = false; root.launch_or_toggle_about(); } }
                        }

                        Rectangle { vertical-stretch: 1; }

                        // All Programs Bar
                        Rectangle {
                            height: 28px;
                            border-radius: 4px;
                            background: ShellPalette.surface-variant;
                            HorizontalLayout {
                                padding-left: 10px;
                                alignment: center;
                                Text { text: "All Programs ▶"; font-size: 11px; font-weight: 700; color: ShellPalette.accent; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // Right Panel: Places
                Rectangle {
                    width: 160px;
                    background: ShellPalette.surface-variant;

                    // Thin separator on left
                    Rectangle {
                        x: 0px;
                        width: 1px;
                        height: parent.height;
                        background: ShellPalette.border-subtle;
                    }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        alignment: start;

                        // User Header
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 28px; height: 28px; border-radius: 14px; background: ShellPalette.accent;
                                Text { text: "👤"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "DeFiveK User"; font-size: 12px; font-weight: 700; color: ShellPalette.text-primary; vertical-alignment: center; }
                        }

                        Rectangle { height: 1px; background: ShellPalette.border-subtle; }

                        Rectangle {
                            height: 26px; border-radius: 4px; background: sm-doc.has-hover ? ShellPalette.surface-hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Rectangle { width: 16px; height: 16px; Text { text: "📁"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } }
                                Text { text: "Documents"; font-size: 11px; color: ShellPalette.text-primary; vertical-alignment: center; }
                            }
                            sm-doc := TouchArea { clicked => { root.start-menu-open = false; root.win-files-open = true; root.win-files-min = false; root.focus_files(); root.files-navigate("~/Documents"); } }
                        }
                        Rectangle {
                            height: 26px; border-radius: 4px; background: sm-dl.has-hover ? ShellPalette.surface-hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Rectangle { width: 16px; height: 16px; Text { text: "📥"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } }
                                Text { text: "Downloads"; font-size: 11px; color: ShellPalette.text-primary; vertical-alignment: center; }
                            }
                            sm-dl := TouchArea { clicked => { root.start-menu-open = false; root.win-files-open = true; root.win-files-min = false; root.focus_files(); root.files-navigate("~/Downloads"); } }
                        }
                        Rectangle {
                            height: 26px; border-radius: 4px; background: sm-prj.has-hover ? ShellPalette.surface-hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Rectangle { width: 16px; height: 16px; Text { text: "⚡"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } }
                                Text { text: "Projects"; font-size: 11px; color: ShellPalette.text-primary; vertical-alignment: center; }
                            }
                            sm-prj := TouchArea { clicked => { root.start-menu-open = false; root.win-files-open = true; root.win-files-min = false; root.focus_files(); root.files-navigate("."); } }
                        }
                        Rectangle {
                            height: 26px; border-radius: 4px; background: sm-cmp.has-hover ? ShellPalette.surface-hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Rectangle { width: 16px; height: 16px; Text { text: "💽"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } }
                                Text { text: "Computer"; font-size: 11px; color: ShellPalette.text-primary; vertical-alignment: center; }
                            }
                            sm-cmp := TouchArea { clicked => { root.start-menu-open = false; root.win-files-open = true; root.win-files-min = false; root.focus_files(); root.files-navigate("/"); } }
                        }

                        Rectangle { height: 1px; background: ShellPalette.border-subtle; }

                        Rectangle {
                            height: 26px; border-radius: 4px; background: sm-cp.has-hover ? ShellPalette.surface-hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Rectangle { width: 16px; height: 16px; Text { text: "⚙️"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } }
                                Text { text: "Control Panel"; font-size: 11px; color: ShellPalette.text-primary; vertical-alignment: center; }
                            }
                            sm-cp := TouchArea { clicked => { root.start-menu-open = false; root.launch_or_toggle_settings(); } }
                        }
                    }
                }
            }

            // Bottom Search Bar & Shutdown Row
            Rectangle {
                height: 44px;
                background: ShellPalette.surface-variant;

                // Thin top separator
                Rectangle {
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: ShellPalette.border;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    // Real Search Input
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: 4px;
                        background: ShellPalette.surface;
                        border-width: 1px;
                        border-color: ShellPalette.border;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;

                            Text { text: "🔍"; font-size: 11px; vertical-alignment: center; }
                            TextInput {
                                text <=> root.start-search-query;
                                font-size: 11px;
                                color: ShellPalette.text-primary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    // Power / Close Shell Button
                    Rectangle {
                        width: 96px;
                        height: 28px;
                        border-radius: 4px;
                        background: pwr-t.has-hover ? #dc2626 : ShellPalette.surface-hover;
                        border-width: 1px;
                        border-color: ShellPalette.border;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "⏻"; font-size: 11px; color: pwr-t.has-hover ? #ffffff : ShellPalette.text-primary; vertical-alignment: center; }
                            Text { text: "Shut down"; font-size: 11px; font-weight: 600; color: pwr-t.has-hover ? #ffffff : ShellPalette.text-primary; vertical-alignment: center; }
                        }
                        pwr-t := TouchArea {
                            clicked => { root.start-menu-open = false; root.app-action("Power Options: Shutdown requested"); }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // 4. Calendar / Clock Popover
    // ==========================================
    if root.calendar-open : Rectangle {
        x: parent.width - 240px;
        y: parent.height - 246px;
        width: 230px;
        height: 196px;
        border-radius: 8px;
        background: ShellPalette.surface;
        border-width: 1px;
        border-color: ShellPalette.border;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: center;

            Text { text: root.clock-time; font-size: 20px; font-weight: 800; color: ShellPalette.accent; horizontal-alignment: center; }
            Text { text: root.clock-date; font-size: 12px; font-weight: 600; color: ShellPalette.text-primary; horizontal-alignment: center; }
            Rectangle { height: 1px; background: ShellPalette.border-subtle; }
            Text { text: "Debian 13 ARM64 System Clock"; font-size: 10px; color: ShellPalette.text-muted; horizontal-alignment: center; }
            Text { text: "Time synchronized with host"; font-size: 10px; color: ShellPalette.success; horizontal-alignment: center; }
        }
    }

    // ==========================================
    // 5. Windows 7 Bottom Taskbar
    // ==========================================
    Rectangle {
        y: parent.height - 46px;
        width: parent.width;
        height: 46px;
        background: ShellPalette.win7-taskbar;

        // Thin top separator
        Rectangle {
            y: 0px;
            width: parent.width;
            height: 1px;
            background: ShellPalette.border;
        }

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 2px;
            spacing: 6px;

            // Start Orb Button
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: root.start-menu-open
                    ? ShellPalette.accent-active
                    : (orb-t.has-hover ? ShellPalette.accent-hover : ShellPalette.win7-aero-blue);
                border-width: 1.5px;
                border-color: root.start-menu-open ? #ffffff : rgba(255, 255, 255, 0.7);

                Image {
                    width: 20px;
                    height: 20px;
                    x: (parent.width - 20px) / 2;
                    y: (parent.height - 20px) / 2;
                    source: @image-url("../../assets/icons/windows-logo.svg");
                }

                orb-t := TouchArea {
                    clicked => { root.start-menu-open = !root.start-menu-open; }
                }
            }

            // --- Running / Pinned Taskbar App Buttons ---

            // File Explorer Taskbar Item
            Rectangle {
                width: root.win-files-open ? 140px : 40px;
                height: 36px;
                border-radius: 4px;
                background: (root.win-files-open && !root.win-files-min && root.win-files-focused)
                    ? ShellPalette.accent-surface
                    : (tb-f.has-hover ? ShellPalette.surface-hover : transparent);
                border-width: root.win-files-open ? 1px : 0px;
                border-color: root.win-files-focused ? ShellPalette.accent : ShellPalette.border;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: start;

                    Rectangle {
                        width: 20px; height: 20px;
                        Text { text: "📁"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.win-files-open : Text {
                        text: "File Explorer";
                        font-size: 11px;
                        font-weight: root.win-files-focused ? 700 : 500;
                        color: ShellPalette.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
                tb-f := TouchArea { clicked => { root.launch_or_toggle_files(); } }
            }

            // Terminal Taskbar Item
            Rectangle {
                width: root.win-term-open ? 130px : 40px;
                height: 36px;
                border-radius: 4px;
                background: (root.win-term-open && !root.win-term-min && root.win-term-focused)
                    ? ShellPalette.accent-surface
                    : (tb-t.has-hover ? ShellPalette.surface-hover : transparent);
                border-width: root.win-term-open ? 1px : 0px;
                border-color: root.win-term-focused ? ShellPalette.accent : ShellPalette.border;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: start;

                    Rectangle {
                        width: 20px; height: 20px;
                        Text { text: "💻"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.win-term-open : Text {
                        text: "Terminal";
                        font-size: 11px;
                        font-weight: root.win-term-focused ? 700 : 500;
                        color: ShellPalette.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
                tb-t := TouchArea { clicked => { root.launch_or_toggle_term(); } }
            }

            // Text Editor Taskbar Item
            Rectangle {
                width: root.win-edit-open ? 130px : 40px;
                height: 36px;
                border-radius: 4px;
                background: (root.win-edit-open && !root.win-edit-min && root.win-edit-focused)
                    ? ShellPalette.accent-surface
                    : (tb-e.has-hover ? ShellPalette.surface-hover : transparent);
                border-width: root.win-edit-open ? 1px : 0px;
                border-color: root.win-edit-focused ? ShellPalette.accent : ShellPalette.border;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: start;

                    Rectangle {
                        width: 20px; height: 20px;
                        Text { text: "📝"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.win-edit-open : Text {
                        text: "Text Editor";
                        font-size: 11px;
                        font-weight: root.win-edit-focused ? 700 : 500;
                        color: ShellPalette.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
                tb-e := TouchArea { clicked => { root.launch_or_toggle_edit(); } }
            }

            // Settings Taskbar Item
            Rectangle {
                width: root.win-settings-open ? 120px : 40px;
                height: 36px;
                border-radius: 4px;
                background: (root.win-settings-open && !root.win-settings-min && root.win-settings-focused)
                    ? ShellPalette.accent-surface
                    : (tb-s.has-hover ? ShellPalette.surface-hover : transparent);
                border-width: root.win-settings-open ? 1px : 0px;
                border-color: root.win-settings-focused ? ShellPalette.accent : ShellPalette.border;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: start;

                    Rectangle {
                        width: 20px; height: 20px;
                        Text { text: "⚙️"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.win-settings-open : Text {
                        text: "Settings";
                        font-size: 11px;
                        font-weight: root.win-settings-focused ? 700 : 500;
                        color: ShellPalette.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
                tb-s := TouchArea { clicked => { root.launch_or_toggle_settings(); } }
            }

            // Spacer
            Rectangle { horizontal-stretch: 1; }

            // System Tray Area
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                Image { width: 15px; height: 15px; source: @image-url("../../assets/icons/wifi.svg"); }
                Image { width: 15px; height: 15px; source: @image-url("../../assets/icons/volume.svg"); }
                Image { width: 15px; height: 15px; source: @image-url("../../assets/icons/battery.svg"); }

                // Clock and Date Stack
                Rectangle {
                    width: 80px;
                    height: 34px;
                    border-radius: 4px;
                    background: clk-t.has-hover ? ShellPalette.surface-hover : transparent;

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.clock-time;
                            font-size: 11px;
                            font-weight: 600;
                            color: ShellPalette.text-primary;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.clock-date;
                            font-size: 9px;
                            color: ShellPalette.text-secondary;
                            horizontal-alignment: center;
                        }
                    }

                    clk-t := TouchArea {
                        clicked => { root.calendar-open = !root.calendar-open; }
                    }
                }

                // Show Desktop Bar (Windows 7 edge peek rectangle)
                Rectangle {
                    width: 12px;
                    height: 36px;
                    border-radius: 2px;
                    background: dsk-peek.has-hover ? ShellPalette.accent : ShellPalette.border;
                    dsk-peek := TouchArea {
                        clicked => { root.toggle_show_desktop(); }
                    }
                }
            }
        }
    }
}
