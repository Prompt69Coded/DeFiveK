// DeFiveK Desktop — Premium Window Chrome (Phase 3)
// Features authentic mode-specific window controls, active/inactive states, dragging, and resizing.

import { ShellPalette } from "theme.slint";

export component WindowFrame inherits Rectangle {
    in-out property <string> title: "Window";
    in-out property <string> icon: "📁";
    in-out property <length> win-x: 80px;
    in-out property <length> win-y: 50px;
    in-out property <length> win-width: 640px;
    in-out property <length> win-height: 440px;
    in-out property <length> min-win-width: 380px;
    in-out property <length> min-win-height: 260px;
    in-out property <length> max-bounds-width: 1200px;
    in-out property <length> max-bounds-height: 720px;
    in-out property <bool> is-open: true;
    in-out property <bool> is-minimized: false;
    in-out property <bool> is-maximized: false;
    in-out property <bool> is-focused: true;
    in-out property <int> mode-style: 0; // 0=Windows, 1=macOS, 2=Android, 3=Aurora

    property <length> normal-x: 80px;
    property <length> normal-y: 50px;
    property <length> normal-w: 640px;
    property <length> normal-h: 440px;

    callback close-clicked();
    callback minimize-clicked();
    callback maximize-clicked();
    callback focused();

    // Position and bounds
    x: root.win-x;
    y: root.win-y;
    width: root.win-width;
    height: root.win-height;
    visible: root.is-open && !root.is-minimized;

    // Window Outer Shell
    border-radius: root.is-maximized ? 0px : (root.mode-style == 1 ? 10px : 8px);
    background: ShellPalette.window-bg;
    border-width: root.is-maximized ? 0px : 1px;
    border-color: root.is-focused ? ShellPalette.window-border-focused : ShellPalette.window-border;
    clip: true;

    function do_toggle_maximize() {
        if (!root.is-maximized) {
            root.normal-x = root.win-x;
            root.normal-y = root.win-y;
            root.normal-w = root.win-width;
            root.normal-h = root.win-height;
            root.win-x = 0px;
            root.win-y = 0px;
            root.win-width = root.max-bounds-width;
            root.win-height = root.max-bounds-height;
            root.is-maximized = true;
        } else {
            root.win-x = root.normal-x;
            root.win-y = root.normal-y;
            root.win-width = root.normal-w;
            root.win-height = root.normal-h;
            root.is-maximized = false;
        }
        root.maximize-clicked();
        root.focused();
    }

    VerticalLayout {
        spacing: 0px;

        // ==========================================
        // 1. Titlebar Area (Exact 36px Height)
        // ==========================================
        Rectangle {
            height: 36px;
            background: root.is-focused ? ShellPalette.window-titlebar : ShellPalette.window-titlebar-inactive;

            // Thin bottom divider
            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ShellPalette.border-subtle;
            }

            // Draggable Interaction Area
            title-drag := TouchArea {
                moved => {
                    if (!root.is-maximized) {
                        root.win-x = max(0px, min(root.max-bounds-width - 80px, root.win-x + (self.mouse-x - self.pressed-x)));
                        root.win-y = max(0px, min(root.max-bounds-height - 40px, root.win-y + (self.mouse-y - self.pressed-y)));
                    }
                }
                clicked => {
                    root.focused();
                }
            }

            // --- macOS Mode: Traffic Lights Left, Title Centered ---
            if root.mode-style == 1 : HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 0px;

                // Traffic Lights Group
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    // Close (Red #ff5f56)
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: mac-cls.has-hover ? #e0443e : ShellPalette.macos-traffic-close;
                        border-width: 1px;
                        border-color: #d63c36;

                        if mac-cls.has-hover : Rectangle {
                            width: 6px;
                            height: 6px;
                            x: (parent.width - 6px) / 2;
                            y: (parent.height - 6px) / 2;
                            // Clean vector cross
                            Rectangle { width: 6px; height: 1.2px; y: 2.4px; background: #4d0000; }
                            Rectangle { width: 1.2px; height: 6px; x: 2.4px; background: #4d0000; }
                        }

                        mac-cls := TouchArea {
                            clicked => { root.close-clicked(); }
                        }
                    }

                    // Minimize (Yellow #ffbd2e)
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: mac-min.has-hover ? #dea123 : ShellPalette.macos-traffic-min;
                        border-width: 1px;
                        border-color: #d8981f;

                        if mac-min.has-hover : Rectangle {
                            width: 6px;
                            height: 1.2px;
                            x: (parent.width - 6px) / 2;
                            y: (parent.height - 1.2px) / 2;
                            background: #593e00;
                        }

                        mac-min := TouchArea {
                            clicked => { root.minimize-clicked(); }
                        }
                    }

                    // Zoom / Maximize (Green #27c93f)
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: mac-max.has-hover ? #1ea332 : ShellPalette.macos-traffic-zoom;
                        border-width: 1px;
                        border-color: #1a942b;

                        if mac-max.has-hover : Rectangle {
                            width: 5px;
                            height: 5px;
                            x: (parent.width - 5px) / 2;
                            y: (parent.height - 5px) / 2;
                            border-width: 1px;
                            border-color: #004d00;
                        }

                        mac-max := TouchArea {
                            clicked => { root.do_toggle_maximize(); }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Centered Title
                Text {
                    text: root.title;
                    font-size: 12px;
                    font-weight: root.is-focused ? 700 : 500;
                    color: root.is-focused ? ShellPalette.text-primary : ShellPalette.text-secondary;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                Rectangle { horizontal-stretch: 1; }

                // Spacer matching traffic lights width (52px) for exact visual balance
                Rectangle { width: 52px; }
            }

            // --- Windows / Android / Aurora Modes: Title Left, Vector Controls Right ---
            if root.mode-style != 1 : HorizontalLayout {
                padding-left: 12px;
                padding-right: 4px;
                spacing: 8px;

                // Left: Title
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    horizontal-stretch: 1;

                    Text {
                        text: root.title;
                        font-size: 12px;
                        font-weight: root.is-focused ? 700 : 500;
                        color: root.is-focused ? ShellPalette.text-primary : ShellPalette.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Right: Vector Window Buttons
                HorizontalLayout {
                    spacing: 2px;
                    alignment: end;

                    // Minimize Button
                    Rectangle {
                        width: 34px;
                        height: 26px;
                        border-radius: 4px;
                        background: win-min.has-hover ? ShellPalette.surface-hover : transparent;

                        // Horizontal line glyph
                        Rectangle {
                            x: (parent.width - 10px) / 2;
                            y: parent.height - 11px;
                            width: 10px;
                            height: 1.5px;
                            background: ShellPalette.text-secondary;
                        }

                        win-min := TouchArea {
                            clicked => { root.minimize-clicked(); }
                        }
                    }

                    // Maximize / Restore Button
                    Rectangle {
                        width: 34px;
                        height: 26px;
                        border-radius: 4px;
                        background: win-max.has-hover ? ShellPalette.surface-hover : transparent;

                        if !root.is-maximized : Rectangle {
                            x: (parent.width - 10px) / 2;
                            y: (parent.height - 10px) / 2;
                            width: 10px;
                            height: 10px;
                            border-width: 1.2px;
                            border-color: ShellPalette.text-secondary;
                        }

                        if root.is-maximized : Rectangle {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - 12px) / 2;
                            y: (parent.height - 12px) / 2;

                            // Back box
                            Rectangle {
                                x: 2px;
                                y: 0px;
                                width: 8px;
                                height: 8px;
                                border-width: 1.2px;
                                border-color: ShellPalette.text-secondary;
                            }
                            // Front box
                            Rectangle {
                                x: 0px;
                                y: 3px;
                                width: 8px;
                                height: 8px;
                                background: ShellPalette.window-titlebar;
                                border-width: 1.2px;
                                border-color: ShellPalette.text-secondary;
                            }
                        }

                        win-max := TouchArea {
                            clicked => { root.do_toggle_maximize(); }
                        }
                    }

                    // Close Button
                    Rectangle {
                        width: 36px;
                        height: 26px;
                        border-radius: 4px;
                        background: win-cls.has-hover ? #ef4444 : transparent;

                        // Vector Cross
                        Rectangle {
                            x: (parent.width - 10px) / 2;
                            y: (parent.height - 10px) / 2;
                            width: 10px;
                            height: 10px;

                            Rectangle {
                                width: 12px;
                                height: 1.5px;
                                x: -1px;
                                y: 4.25px;
                                background: win-cls.has-hover ? #ffffff : ShellPalette.text-secondary;
                            }
                            Rectangle {
                                width: 1.5px;
                                height: 12px;
                                x: 4.25px;
                                y: -1px;
                                background: win-cls.has-hover ? #ffffff : ShellPalette.text-secondary;
                            }
                        }

                        win-cls := TouchArea {
                            clicked => { root.close-clicked(); }
                        }
                    }
                }
            }
        }

        // ==========================================
        // 2. Window Content Area
        // ==========================================
        Rectangle {
            vertical-stretch: 1;
            background: ShellPalette.window-bg;
            clip: true;

            // Focus on body touch
            TouchArea {
                clicked => { root.focused(); }
            }

            @children
        }
    }

    // ==========================================
    // 3. Resize Corner Handle (Bottom-Right)
    // ==========================================
    if !root.is-maximized : Rectangle {
        x: parent.width - 16px;
        y: parent.height - 16px;
        width: 16px;
        height: 16px;

        // Clean diagonal grip lines
        Rectangle { x: 10px; y: 10px; width: 2px; height: 2px; border-radius: 1px; background: res-touch.has-hover ? ShellPalette.accent : ShellPalette.border-strong; }
        Rectangle { x: 6px; y: 10px; width: 2px; height: 2px; border-radius: 1px; background: res-touch.has-hover ? ShellPalette.accent : ShellPalette.border-strong; }
        Rectangle { x: 10px; y: 6px; width: 2px; height: 2px; border-radius: 1px; background: res-touch.has-hover ? ShellPalette.accent : ShellPalette.border-strong; }

        res-touch := TouchArea {
            moved => {
                root.win-width = max(root.min-win-width, min(root.max-bounds-width, root.win-width + (self.mouse-x - self.pressed-x)));
                root.win-height = max(root.min-win-height, min(root.max-bounds-height, root.win-height + (self.mouse-y - self.pressed-y)));
            }
            clicked => {
                root.focused();
            }
        }
    }
}
