import { ShellPalette } from "theme.slint";
import { WindowFrame } from "window_frame.slint";
import { AppFiles, FileItemData } from "app_files.slint";
import { AppTerminal } from "app_terminal.slint";
import { AppEditor } from "app_editor.slint";
import { AppSettings } from "app_settings.slint";
import { AppAbout } from "app_about.slint";

export component MacosMode inherits Rectangle {
    in-out property <string> clock-time: "12:00 PM";
    in-out property <string> clock-date: "Fri Oct 23";
    in-out property <bool> apple-menu-open: false;
    in-out property <bool> control-center-open: false;

    // Window Management State
    in-out property <bool> win-files-open: true;
    in-out property <bool> win-files-min: false;
    in-out property <bool> win-files-focused: true;

    in-out property <bool> win-term-open: false;
    in-out property <bool> win-term-min: false;
    in-out property <bool> win-term-focused: false;

    in-out property <bool> win-edit-open: false;
    in-out property <bool> win-edit-min: false;
    in-out property <bool> win-edit-focused: false;

    in-out property <bool> win-settings-open: false;
    in-out property <bool> win-settings-min: false;
    in-out property <bool> win-settings-focused: false;

    in-out property <bool> win-about-open: false;
    in-out property <bool> win-about-min: false;
    in-out property <bool> win-about-focused: false;

    // App Data bindings
    in-out property <string> files-current-path: "/home/harry/Projects/defivek";
    in-out property <[FileItemData]> files-items;
    in-out property <int> files-selected-index: -1;
    in-out property <string> files-status-text: "Ready";
    in-out property <string> files-error-text: "";
    in-out property <bool> files-has-error: false;

    in-out property <string> term-output: "";
    in-out property <string> host-terminal-name: "Terminal";

    in-out property <string> edit-file-path: "";
    in-out property <string> edit-file-content: "";
    in-out property <string> edit-status: "Ready";
    in-out property <bool> edit-is-modified: false;

    // Callbacks to parent
    in-out property <string> selected-wallpaper: "aurora-borealis";
    callback wallpaper-selected(string);
    callback app-action(string);
    callback files-navigate(string);
    callback files-navigate-up();
    callback files-navigate-back();
    callback files-refresh();
    callback files-open-item(string, bool);

    callback term-run-command(string);
    callback term-launch-host();
    callback term-clear();

    callback edit-new();
    callback edit-open-preset(string);
    callback edit-save(string, string);

    callback settings-mode-selected(int);
    callback settings-toggle-theme();
    callback settings-toggle-shell-bar();
    callback settings-reset();

    // Helper functions for window focus & launch
    function focus_files() {
        root.win-files-focused = true;
        root.win-term-focused = false;
        root.win-edit-focused = false;
        root.win-settings-focused = false;
        root.win-about-focused = false;
    }
    function focus_term() {
        root.win-files-focused = false;
        root.win-term-focused = true;
        root.win-edit-focused = false;
        root.win-settings-focused = false;
        root.win-about-focused = false;
    }
    function focus_edit() {
        root.win-files-focused = false;
        root.win-term-focused = false;
        root.win-edit-focused = true;
        root.win-settings-focused = false;
        root.win-about-focused = false;
    }
    function focus_settings() {
        root.win-files-focused = false;
        root.win-term-focused = false;
        root.win-edit-focused = false;
        root.win-settings-focused = true;
        root.win-about-focused = false;
    }
    function focus_about() {
        root.win-files-focused = false;
        root.win-term-focused = false;
        root.win-edit-focused = false;
        root.win-settings-focused = false;
        root.win-about-focused = true;
    }

    function toggle_files() {
        if (!root.win-files-open) {
            root.win-files-open = true;
            root.win-files-min = false;
            root.focus_files();
        } else if (root.win-files-min) {
            root.win-files-min = false;
            root.focus_files();
        } else if (root.win-files-focused) {
            root.win-files-min = true;
        } else {
            root.focus_files();
        }
    }

    function toggle_term() {
        if (!root.win-term-open) {
            root.win-term-open = true;
            root.win-term-min = false;
            root.focus_term();
        } else if (root.win-term-min) {
            root.win-term-min = false;
            root.focus_term();
        } else if (root.win-term-focused) {
            root.win-term-min = true;
        } else {
            root.focus_term();
        }
    }

    function toggle_edit() {
        if (!root.win-edit-open) {
            root.win-edit-open = true;
            root.win-edit-min = false;
            root.focus_edit();
        } else if (root.win-edit-min) {
            root.win-edit-min = false;
            root.focus_edit();
        } else if (root.win-edit-focused) {
            root.win-edit-min = true;
        } else {
            root.focus_edit();
        }
    }

    function toggle_settings() {
        if (!root.win-settings-open) {
            root.win-settings-open = true;
            root.win-settings-min = false;
            root.focus_settings();
        } else if (root.win-settings-min) {
            root.win-settings-min = false;
            root.focus_settings();
        } else if (root.win-settings-focused) {
            root.win-settings-min = true;
        } else {
            root.focus_settings();
        }
    }

    function toggle_about() {
        if (!root.win-about-open) {
            root.win-about-open = true;
            root.win-about-min = false;
            root.focus_about();
        } else if (root.win-about-min) {
            root.win-about-min = false;
            root.focus_about();
        } else if (root.win-about-focused) {
            root.win-about-min = true;
        } else {
            root.focus_about();
        }
    }

    // macOS Yosemite Transparent Workspace (Wallpapers rendered by shared engine)
    background: transparent;

    // ==========================================
    // 1. Top OS X Menu Bar
    // ==========================================
    Rectangle {
        y: 0px;
        width: parent.width;
        height: 28px;
        background: ShellPalette.macos-menubar;

        // Thin separator
        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: ShellPalette.border;
        }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;

            // Apple / DeFiveK Logo
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                background: apl-t.has-hover ? ShellPalette.surface-hover : transparent;
                Image {
                    width: 15px;
                    height: 15px;
                    x: (parent.width - 15px) / 2;
                    y: (parent.height - 15px) / 2;
                    source: @image-url("../../assets/icons/apple-logo.svg");
                }
                apl-t := TouchArea {
                    clicked => {
                        root.apple-menu-open = !root.apple-menu-open;
                        root.control-center-open = false;
                    }
                }
            }

            // Context-adaptive Active App Title
            Text {
                text: root.win-term-focused ? "Terminal"
                    : root.win-edit-focused ? "TextEdit"
                    : root.win-settings-focused ? "System Preferences"
                    : root.win-about-focused ? "DeFiveK"
                    : "Finder";
                font-size: 12px;
                font-weight: 800;
                color: ShellPalette.text-primary;
                vertical-alignment: center;
            }

            // Standard Menus
            Rectangle {
                height: 22px; border-radius: 3px; background: m-file.has-hover ? ShellPalette.surface-hover : transparent;
                HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "File"; font-size: 12px; color: ShellPalette.text-primary; vertical-alignment: center; } }
                m-file := TouchArea { clicked => { root.toggle_files(); } }
            }
            Rectangle {
                height: 22px; border-radius: 3px; background: m-edit.has-hover ? ShellPalette.surface-hover : transparent;
                HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "Edit"; font-size: 12px; color: ShellPalette.text-primary; vertical-alignment: center; } }
                m-edit := TouchArea { clicked => { root.toggle_edit(); } }
            }
            Rectangle {
                height: 22px; border-radius: 3px; background: m-view.has-hover ? ShellPalette.surface-hover : transparent;
                HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "View"; font-size: 12px; color: ShellPalette.text-primary; vertical-alignment: center; } }
                m-view := TouchArea { clicked => { root.settings-toggle-theme(); } }
            }
            Rectangle {
                height: 22px; border-radius: 3px; background: m-win.has-hover ? ShellPalette.surface-hover : transparent;
                HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "Window"; font-size: 12px; color: ShellPalette.text-primary; vertical-alignment: center; } }
                m-win := TouchArea { clicked => { root.toggle_term(); } }
            }
            Rectangle {
                height: 22px; border-radius: 3px; background: m-hlp.has-hover ? ShellPalette.surface-hover : transparent;
                HorizontalLayout { padding-left: 4px; padding-right: 4px; Text { text: "Help"; font-size: 12px; color: ShellPalette.text-primary; vertical-alignment: center; } }
                m-hlp := TouchArea { clicked => { root.toggle_about(); } }
            }

            Rectangle { horizontal-stretch: 1; }

            // Right Status Bar Items
            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Image { width: 15px; height: 15px; source: @image-url("../../assets/icons/battery.svg"); }
                Image { width: 14px; height: 14px; source: @image-url("../../assets/icons/wifi.svg"); }

                // Control Center Toggle
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 3px;
                    background: cc-t.has-hover ? ShellPalette.surface-hover : transparent;
                    Text { text: "☰"; font-size: 12px; color: ShellPalette.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                    cc-t := TouchArea {
                        clicked => {
                            root.control-center-open = !root.control-center-open;
                            root.apple-menu-open = false;
                        }
                    }
                }

                // Clock
                Text {
                    text: root.clock-date + "  " + root.clock-time;
                    font-size: 11px;
                    font-weight: 600;
                    color: ShellPalette.text-primary;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ==========================================
    // 2. Apple Menu Popover
    // ==========================================
    if root.apple-menu-open : Rectangle {
        x: 10px;
        y: 30px;
        width: 200px;
        height: 180px;
        border-radius: 6px;
        background: ShellPalette.surface;
        border-width: 1px;
        border-color: ShellPalette.border;

        VerticalLayout {
            padding: 6px;
            spacing: 2px;

            Rectangle {
                height: 26px; border-radius: 4px; background: ap-ab.has-hover ? ShellPalette.accent : transparent;
                HorizontalLayout { padding-left: 8px; Text { text: "About DeFiveK Desktop"; font-size: 11px; font-weight: 600; color: ap-ab.has-hover ? #ffffff : ShellPalette.text-primary; vertical-alignment: center; } }
                ap-ab := TouchArea { clicked => { root.apple-menu-open = false; root.toggle_about(); } }
            }
            Rectangle { height: 1px; background: ShellPalette.border-subtle; }
            Rectangle {
                height: 26px; border-radius: 4px; background: ap-st.has-hover ? ShellPalette.accent : transparent;
                HorizontalLayout { padding-left: 8px; Text { text: "System Preferences..."; font-size: 11px; color: ap-st.has-hover ? #ffffff : ShellPalette.text-primary; vertical-alignment: center; } }
                ap-st := TouchArea { clicked => { root.apple-menu-open = false; root.toggle_settings(); } }
            }
            Rectangle {
                height: 26px; border-radius: 4px; background: ap-th.has-hover ? ShellPalette.accent : transparent;
                HorizontalLayout { padding-left: 8px; Text { text: ShellPalette.dark-mode ? "Switch to Light Mode" : "Switch to Dark Mode"; font-size: 11px; color: ap-th.has-hover ? #ffffff : ShellPalette.text-primary; vertical-alignment: center; } }
                ap-th := TouchArea { clicked => { root.apple-menu-open = false; root.settings-toggle-theme(); } }
            }
            Rectangle { height: 1px; background: ShellPalette.border-subtle; }
            Rectangle {
                height: 26px; border-radius: 4px; background: ap-rst.has-hover ? #ef4444 : transparent;
                HorizontalLayout { padding-left: 8px; Text { text: "Restart DeFiveK Shell..."; font-size: 11px; color: ap-rst.has-hover ? #ffffff : ShellPalette.text-primary; vertical-alignment: center; } }
                ap-rst := TouchArea { clicked => { root.apple-menu-open = false; root.app-action("Restart Requested"); } }
            }
            Rectangle {
                height: 26px; border-radius: 4px; background: ap-lo.has-hover ? #ef4444 : transparent;
                HorizontalLayout { padding-left: 8px; Text { text: "Log Out Harry..."; font-size: 11px; color: ap-lo.has-hover ? #ffffff : ShellPalette.text-primary; vertical-alignment: center; } }
                ap-lo := TouchArea { clicked => { root.apple-menu-open = false; root.app-action("Log Out Requested"); } }
            }
        }
    }

    // ==========================================
    // 3. Control Center Popover
    // ==========================================
    if root.control-center-open : Rectangle {
        x: parent.width - 240px;
        y: 30px;
        width: 230px;
        height: 180px;
        border-radius: 8px;
        background: ShellPalette.surface;
        border-width: 1px;
        border-color: ShellPalette.border;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text { text: "Control Center"; font-size: 12px; font-weight: 700; color: ShellPalette.text-primary; }
            Rectangle { height: 1px; background: ShellPalette.border-subtle; }

            // Theme Toggle
            Rectangle {
                height: 36px; border-radius: 6px; background: ShellPalette.surface-variant;
                HorizontalLayout { padding-left: 10px; padding-right: 10px; alignment: center;
                    Text { text: "🌓"; font-size: 13px; vertical-alignment: center; }
                    Rectangle { width: 8px; }
                    Text { text: "Dark Mode"; font-size: 11px; font-weight: 600; color: ShellPalette.text-primary; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: ShellPalette.dark-mode ? "ON" : "OFF"; font-size: 11px; font-weight: 700; color: ShellPalette.accent; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.settings-toggle-theme(); } }
            }

            // Display Info
            Rectangle {
                height: 36px; border-radius: 6px; background: ShellPalette.surface-variant;
                HorizontalLayout { padding-left: 10px; padding-right: 10px; alignment: center;
                    Text { text: "🖥️"; font-size: 13px; vertical-alignment: center; }
                    Rectangle { width: 8px; }
                    VerticalLayout { alignment: center; spacing: 1px;
                        Text { text: "Debian 13 VirGL"; font-size: 10px; font-weight: 600; color: ShellPalette.text-primary; }
                        Text { text: "AArch64 Session"; font-size: 9px; color: ShellPalette.text-muted; }
                    }
                }
            }

            // Sound
            HorizontalLayout {
                spacing: 8px; alignment: center;
                Text { text: "🔊"; font-size: 12px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; height: 6px; border-radius: 3px; background: ShellPalette.accent; }
            }
        }
    }

    // ==========================================
    // 4. Desktop Workspace & Application Windows
    // ==========================================
    workspace := Rectangle {
        x: 0px;
        y: 28px;
        width: parent.width;
        height: parent.height - 94px;

        // Dismiss menus when clicking workspace background
        TouchArea {
            clicked => {
                root.apple-menu-open = false;
                root.control-center-open = false;
            }
        }

        // Desktop Shortcut: DeFiveK HD (Top Right)
        Rectangle {
            x: parent.width - 94px;
            y: 16px;
            width: 80px;
            height: 74px;
            border-radius: 6px;
            background: hd-t.has-hover ? ShellPalette.accent-surface : transparent;
            border-width: 1px;
            border-color: hd-t.has-hover ? ShellPalette.accent : transparent;

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: "💽"; font-size: 26px; horizontal-alignment: center; }
                Text { text: "DeFiveK HD"; font-size: 11px; font-weight: 600; color: #ffffff; horizontal-alignment: center; }
            }
            hd-t := TouchArea {
                clicked => {
                    root.win-files-open = true;
                    root.win-files-min = false;
                    root.focus_files();
                    root.files-navigate("/");
                }
            }
        }

        // --- Window 1: Finder (AppFiles) ---
        WindowFrame {
            title: "Finder — " + root.files-current-path;
            icon: "📁";
            win-x: 50px;
            win-y: 20px;
            win-width: min(680px, workspace.width - 70px);
            win-height: min(420px, workspace.height - 40px);
            max-bounds-width: workspace.width;
            max-bounds-height: workspace.height;
            is-open: root.win-files-open;
            is-minimized: root.win-files-min;
            is-focused: root.win-files-focused;
            mode-style: 1;

            focused => { root.focus_files(); }
            close-clicked => { root.win-files-open = false; }
            minimize-clicked => { root.win-files-min = true; }

            AppFiles {
                current-path: root.files-current-path;
                items: root.files-items;
                selected-index: root.files-selected-index;
                status-text: root.files-status-text;
                error-text: root.files-error-text;
                has-error: root.files-has-error;

                navigate-to(p) => { root.files-navigate(p); }
                navigate-up => { root.files-navigate-up(); }
                navigate-back => { root.files-navigate-back(); }
                refresh-folder => { root.files-refresh(); }
                open-item(p, is_dir) => { root.files-open-item(p, is_dir); }
            }
        }

        // --- Window 2: Terminal ---
        WindowFrame {
            title: "Terminal — zsh";
            icon: "💻";
            win-x: 100px;
            win-y: 50px;
            win-width: min(620px, workspace.width - 120px);
            win-height: min(380px, workspace.height - 70px);
            max-bounds-width: workspace.width;
            max-bounds-height: workspace.height;
            is-open: root.win-term-open;
            is-minimized: root.win-term-min;
            is-focused: root.win-term-focused;
            mode-style: 1;

            focused => { root.focus_term(); }
            close-clicked => { root.win-term-open = false; }
            minimize-clicked => { root.win-term-min = true; }

            AppTerminal {
                terminal-output: root.term-output;
                host-terminal-name: root.host-terminal-name;
                run-command(cmd) => { root.term-run-command(cmd); }
                launch-host-terminal => { root.term-launch-host(); }
                clear-output => { root.term-clear(); }
            }
        }

        // --- Window 3: TextEdit ---
        WindowFrame {
            title: "TextEdit — " + root.edit-file-path;
            icon: "📝";
            win-x: 150px;
            win-y: 70px;
            win-width: min(600px, workspace.width - 170px);
            win-height: min(400px, workspace.height - 90px);
            max-bounds-width: workspace.width;
            max-bounds-height: workspace.height;
            is-open: root.win-edit-open;
            is-minimized: root.win-edit-min;
            is-focused: root.win-edit-focused;
            mode-style: 1;

            focused => { root.focus_edit(); }
            close-clicked => { root.win-edit-open = false; }
            minimize-clicked => { root.win-edit-min = true; }

            AppEditor {
                file-path: root.edit-file-path;
                file-content: root.edit-file-content;
                status-message: root.edit-status;
                is-modified: root.edit-is-modified;

                new-file => { root.edit-new(); }
                open-preset(p) => { root.edit-open-preset(p); }
                save-file(p, c) => { root.edit-save(p, c); }
            }
        }

        // --- Window 4: System Preferences ---
        WindowFrame {
            title: "System Preferences";
            icon: "⚙️";
            win-x: 180px;
            win-y: 60px;
            win-width: min(600px, workspace.width - 200px);
            win-height: min(440px, workspace.height - 80px);
            max-bounds-width: workspace.width;
            max-bounds-height: workspace.height;
            is-open: root.win-settings-open;
            is-minimized: root.win-settings-min;
            is-focused: root.win-settings-focused;
            mode-style: 1;

            focused => { root.focus_settings(); }
            close-clicked => { root.win-settings-open = false; }
            minimize-clicked => { root.win-settings-min = true; }

            AppSettings {
                current-mode: 1;
                dark-mode: ShellPalette.dark-mode;
                selected-wallpaper: root.selected-wallpaper;
                wallpaper-selected(w) => { root.wallpaper-selected(w); }
                mode-selected(m) => { root.settings-mode-selected(m); }
                toggle-theme => { root.settings-toggle-theme(); }
                toggle-shell-bar => { root.settings-toggle-shell-bar(); }
                reset-defaults => { root.settings-reset(); }
            }
        }

        // --- Window 5: About DeFiveK Desktop ---
        WindowFrame {
            title: "About DeFiveK Desktop";
            icon: "✦";
            win-x: 220px;
            win-y: 80px;
            win-width: min(520px, workspace.width - 240px);
            win-height: min(380px, workspace.height - 100px);
            max-bounds-width: workspace.width;
            max-bounds-height: workspace.height;
            is-open: root.win-about-open;
            is-minimized: root.win-about-min;
            is-focused: root.win-about-focused;
            mode-style: 1;

            focused => { root.focus_about(); }
            close-clicked => { root.win-about-open = false; }
            minimize-clicked => { root.win-about-min = true; }

            AppAbout {
                current-mode: 1;
            }
        }
    }

    // ==========================================
    // 5. Yosemite Floating Dock
    // ==========================================
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 62px;
        width: 320px;
        height: 54px;
        border-radius: 16px;
        background: ShellPalette.macos-dock;
        border-width: 1px;
        border-color: ShellPalette.border;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;
            alignment: center;

            // Finder (Files)
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Rectangle {
                    width: 38px; height: 38px; border-radius: 10px;
                    background: dk-f.has-hover ? ShellPalette.surface-hover : ShellPalette.surface-variant;
                    Image {
                        width: 24px; height: 24px;
                        x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2;
                        source: @image-url("../../assets/icons/folder.svg");
                    }
                    dk-f := TouchArea { clicked => { root.toggle_files(); } }
                }
                // Active indicator dot
                Rectangle {
                    width: 4px; height: 4px; border-radius: 2px;
                    background: root.win-files-open ? ShellPalette.accent : transparent;
                }
            }

            // Terminal
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Rectangle {
                    width: 38px; height: 38px; border-radius: 10px;
                    background: dk-t.has-hover ? ShellPalette.surface-hover : ShellPalette.surface-variant;
                    Image {
                        width: 24px; height: 24px;
                        x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2;
                        source: @image-url("../../assets/icons/terminal.svg");
                    }
                    dk-t := TouchArea { clicked => { root.toggle_term(); } }
                }
                Rectangle {
                    width: 4px; height: 4px; border-radius: 2px;
                    background: root.win-term-open ? ShellPalette.accent : transparent;
                }
            }

            // TextEdit
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Rectangle {
                    width: 38px; height: 38px; border-radius: 10px;
                    background: dk-e.has-hover ? ShellPalette.surface-hover : ShellPalette.surface-variant;
                    Image {
                        width: 24px; height: 24px;
                        x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2;
                        source: @image-url("../../assets/icons/editor.svg");
                    }
                    dk-e := TouchArea { clicked => { root.toggle_edit(); } }
                }
                Rectangle {
                    width: 4px; height: 4px; border-radius: 2px;
                    background: root.win-edit-open ? ShellPalette.accent : transparent;
                }
            }

            // System Preferences
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Rectangle {
                    width: 38px; height: 38px; border-radius: 10px;
                    background: dk-s.has-hover ? ShellPalette.surface-hover : ShellPalette.surface-variant;
                    Image {
                        width: 24px; height: 24px;
                        x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2;
                        source: @image-url("../../assets/icons/settings.svg");
                    }
                    dk-s := TouchArea { clicked => { root.toggle_settings(); } }
                }
                Rectangle {
                    width: 4px; height: 4px; border-radius: 2px;
                    background: root.win-settings-open ? ShellPalette.accent : transparent;
                }
            }

            // Dock Divider
            Rectangle { width: 1px; height: 28px; background: ShellPalette.border; }

            // Trash
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Rectangle {
                    width: 38px; height: 38px; border-radius: 10px;
                    background: dk-tr.has-hover ? ShellPalette.surface-hover : ShellPalette.surface-variant;
                    Image {
                        width: 24px; height: 24px;
                        x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2;
                        source: @image-url("../../assets/icons/trash.svg");
                    }
                    dk-tr := TouchArea { clicked => { root.app-action("Trash is empty"); } }
                }
                Rectangle { width: 4px; height: 4px; background: transparent; }
            }
        }
    }
}
